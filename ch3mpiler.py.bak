class Ch3mpiler:
    """Retrosynthetic/Forward Reaction Compiler grounded in IG structural types."""
    def __init__(self):
        self.cat = self._load()
    def _load(self):
        try:
            with open(CATALOG_PATH) as f: return json.load(f)
        except: return []
    def _tup(self, e):
        return {pn:g2v(pn,e.get(pf,""))[0] for pn,pf in zip(PNAMES,PFIELDS)}
    def analyze(self, target):
        """Analyze a target molecule: type + matching disconnections"""
        tup = {}
        # Try exact catalog match first
        for e in self.cat:
            if e.get("name","") == target:
                tup = self._tup(e)
                break
        if not tup:
            # Build type from FG composition
            tup = self._compose_from_name(target)
        matches = []
        for rn, r in RXN.items():
            post = r.get("post",{})
            d, cf = tup_dist(tup, post)
            if d < 3.5:
                matches.append({"rxn":rn,"cut":r.get("cut",""),"d":round(d,3),"conflicts":len(cf)})
        matches.sort(key=lambda x: x["d"])
        analogs = []
        for e in self.cat[:500]:
            et = self._tup(e)
            d, _ = tup_dist(tup, et)
            if d < 3.5:
                analogs.append({"n":e.get("name",""),"d":round(d,3)})
        analogs.sort(key=lambda x: x["d"])
        return {"target":target,"type":fmt_tup(tup),"cuts":matches[:8],"analogs":analogs[:10]}
    def _compose_from_name(self, name):
        """Build structural type by composing FG tokens found in molecule name."""
        name_lower = name.lower().replace("_"," ").replace("-"," ")
        found_fgs = set()
        for token, fg_name in FG_TOKENS.items():
            if token in name_lower:
                found_fgs.add(fg_name)
        if not found_fgs:
            # Try partial catalog match
            for e in self.cat[:200]:
                en = e.get("name","").lower()
                if name_lower in en or en in name_lower:
                    found_fgs.add("__catalog__")
                    tup = self._tup(e)
                    return tup
            return {p:"?" for p in PNAMES}
        # Compose: take ordinal max for most primitives, min for P and F
        ord_vals = {p:[] for p in PNAMES}
        for fg in found_fgs:
            d = FG.get(fg, {})
            for p in PNAMES:
                v = d.get(p, "")
                if v:
                    _, o = g2v(p, v)
                    ord_vals[p].append(o)
        for p in PNAMES:
            if not ord_vals[p]:
                ord_vals[p] = [0]
        # Need to map ordinals back to glyphs via ORDINALS/FIELD_TO_ORD
        result = {}
        for p in PNAMES:
            vals = ord_vals[p]
            if p in ("P","F"):
                o = min(vals)  # P and F take min (most restrictive)
            else:
                o = max(vals)  # others take max (most expressive)
            # Map ordinal back to glyph
            ord_key = FIELD_TO_ORD.get(p, p)
            om = ORDINALS.get(ord_key, {})
            # Invert: ordinal -> glyph
            rev = {v:k for k,v in om.items()}
            result[p] = rev.get(o, "?")
        return result

    def retrosynthesis(self, target, depth=2):
        """Recursive retrosynthetic analysis down to depth."""
        result = self.analyze(target)
        tree = {"target":target,"type":result["type"],"cuts":result["cuts"],"precursors":[]}
        if depth > 0:
            for m in result["cuts"][:3]:
                sub = target + "_" + m["rxn"]
                tree["precursors"].append(self.retrosynthesis(sub, depth-1))
        return tree
    def forward(self, reagents):
        """Predict reaction product from reagent list."""
        if not reagents: return None
        # Average the reagent types to get composite
        avg_tup = {p:"?" for p in PNAMES}
        counts = {}
        for p in PNAMES:
            vals = []
            for r in reagents:
                for e in self.cat[:500]:
                    if e.get("name","") == r:
                        vals.append(self._tup(e).get(p,"?"))
                        break
                else:
                    # Check FG
                    if r in FG:
                        vals.append(FG[r].get(p,"?"))
            if vals:
                counts[p] = len(vals)
                # Use most common
                from collections import Counter
                c = Counter(vals)
                avg_tup[p] = c.most_common(1)[0][0]
        # Find reaction with closest pre match
        best = None
        best_d = 999
        for rn, r in RXN.items():
            pre = r.get("pre",{})
            d, cf = tup_dist(avg_tup, pre)
            if d < best_d:
                best_d = d
                best = rn
        return {"reagents":reagents,"composite_type":fmt_tup(avg_tup),
                "matched_rxn":best,"distance":round(best_d,3),
                "predicted_product":RXN.get(best,{}).get("post",{})}



def main():
    # Normalize unicode dashes (U+2212, U+2013, U+2014, etc.) to ASCII hyphen
    _dash_map = str.maketrans({chr(c): '-' for c in [0x2212, 0x2013, 0x2014, 0x2015, 0xff0d, 0xfe63]})
    import sys as _sys
    _sys.argv = [s.translate(_dash_map) for s in _sys.argv]
    parser = argparse.ArgumentParser(description="ch3mpiler - IG-grounded retrosynthetic/forward reaction compiler")
    parser.add_argument("--target", help="Target molecule name to analyze")
    parser.add_argument("--retrosynthesis", action="store_true", help="Recursive retrosynthetic analysis")
    parser.add_argument("--forward", nargs="+", help="Reagents for forward prediction")
    parser.add_argument("--interactive", action="store_true", help="Interactive mode")
    parser.add_argument("--fg", help="Analyze a functional group type")
    args = parser.parse_args()
    ch = Ch3mpiler()
    if args.fg:
        if args.fg in FG:
            t = {p:FG[args.fg].get(p,"?") for p in PNAMES}
            print(f"FG: {args.fg}")
            print(f"Type: {fmt_tup(t)}")
        else:
            print(f"Unknown FG: {args.fg}")
    elif args.target:
        if args.retrosynthesis:
            r = ch.retrosynthesis(args.target)
            def show(t, indent=0):
                p = "  "*indent
                print(f"{p}{t['target']} [{t['type']}]")
                for c in t.get("cuts",[])[:3]:
                    print(f"{p}  {c['rxn']} (d={c['d']}): {c['cut']}")
                for s in t.get("precursors",[]):
                    show(s, indent+1)
            show(r)
        else:
            r = ch.analyze(args.target)
            print(f"Target: {r['target']}")
            print(f"Type: {r['type']}")
            print(f"\nMatching disconnections:")
            for m in r["cuts"]:
                print(f"  {m['rxn']} (d={m['d']}, conflicts={m['conflicts']}): {m['cut']}")
            print(f"\nStructural analogs:")
            for a in r["analogs"][:5]:
                print(f"  {a['n']} (d={a['d']})")
    elif args.forward:
        r = ch.forward(args.forward)
        if r:
            print(f"Reagents: {', '.join(r['reagents'])}")
            print(f"Composite type: {r['composite_type']}")
            print(f"Matched reaction: {r['matched_rxn']} (d={r['distance']})")
            if r['predicted_product']:
                print(f"Predicted product type: {fmt_tup(r['predicted_product'])}")
    elif args.interactive:
        print("ch3mpiler interactive -- type target, 'fg:<name>', 'retro:<name>', 'fwd:<r1,r2,...>', 'quit'")
        while True:
            try:
                c = input(">>> ").strip()
                if c in ("quit","q"): break
                if c.startswith("fg:"):
                    fg = c[3:]
                    if fg in FG:
                        t = {p:FG[fg].get(p,"?") for p in PNAMES}
                        print(f"FG {fg}: {fmt_tup(t)}")
                elif c.startswith("retro:"):
                    t = c[6:]
                    r = ch.retrosynthesis(t, depth=1)
                    print(f"Retrosynthesis of {t} [{r['type']}]")
                    for m in r["cuts"][:5]:
                        print(f"  {m['rxn']} (d={m['d']}): {m['cut']}")
                elif c.startswith("fwd:"):
                    reagents = c[4:].split(",")
                    r = ch.forward(reagents)
                    if r:
                        print(f"Forward: {', '.join(r['reagents'])} -> {r['matched_rxn']} (d={r['distance']})")
                else:
                    r = ch.analyze(c)
                    print(f"Target: {c}")
                    print(f"Type: {r['type']}")
                    for m in r["cuts"][:3]:
                        print(f"  {m['rxn']} (d={m['d']}): {m['cut']}")
                    for a in r["analogs"][:3]:
                        print(f"  analog: {a['n']} (d={a['d']})")
            except EOFError: break
            except KeyboardInterrupt: break
    else:
        print("ch3mpiler - IG-grounded reaction compiler")
        print("Usage:")
        print("  --target <name>              Analyze target molecule")
        print("  --target <name> --retrosynthesis  Recursive retrosynthesis")
        print("  --forward r1 r2 ...          Predict forward reaction")
        print("  --fg <name>                  Analyze functional group")
        print("  --interactive                Interactive shell")
        print()
        print("Demo: benzaldehyde")
        r = ch.analyze("benzaldehyde")
        print(f"Type: {r['type']}")
        for m in r["cuts"][:4]:
            print(f"  {m['rxn']} (d={m['d']}): {m['cut']}")
if __name__ == "__main__": main()
