
<style>
h2.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.root{padding:1rem 0;font-size:14px;color:var(--color-text-primary)}
.sys-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:1.5rem}
@media(max-width:540px){.sys-grid{grid-template-columns:1fr}}
.panel{background:var(--color-background-primary);border:0.5px solid var(--color-border-tertiary);border-radius:var(--border-radius-lg);padding:1rem}
.panel-title{font-size:15px;font-weight:500;margin:0 0 4px;color:var(--color-text-primary)}
.panel-sub{font-size:12px;color:var(--color-text-secondary);margin:0 0 12px;line-height:1.5}
.info-box{margin-top:12px;padding:10px 12px;border-radius:var(--border-radius-md);background:var(--color-background-secondary);min-height:56px}
.info-label{font-size:11px;color:var(--color-text-tertiary);margin:0 0 3px}
.info-val{font-size:13px;color:var(--color-text-primary);line-height:1.5}
.prob-row{display:flex;align-items:center;gap:8px;margin-top:6px}
.prob-label{font-size:11px;color:var(--color-text-secondary);min-width:16px}
.prob-bar-wrap{flex:1;height:6px;background:var(--color-background-secondary);border-radius:3px;overflow:hidden;border:0.5px solid var(--color-border-tertiary)}
.prob-bar{height:6px;border-radius:3px;transition:width .3s}
.prob-num{font-size:11px;color:var(--color-text-secondary);min-width:32px;text-align:right}
.frustration-bar{margin-top:8px;padding:6px 10px;border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-secondary);font-size:12px;color:var(--color-text-secondary);transition:background .3s,color .3s}
.frustration-bar.active{background:var(--color-background-warning);color:var(--color-text-warning);border-color:var(--color-border-warning)}
.divider{border:none;border-top:0.5px solid var(--color-border-tertiary);margin:1rem 0}
.comparison{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
@media(max-width:540px){.comparison{grid-template-columns:1fr}}
.cmp-card{background:var(--color-background-secondary);border-radius:var(--border-radius-md);padding:10px 12px}
.cmp-card-title{font-size:12px;font-weight:500;color:var(--color-text-primary);margin:0 0 4px}
.cmp-card-body{font-size:12px;color:var(--color-text-secondary);line-height:1.6}
</style>

<div class="root">
<h2 class="sr-only">Electron orbitals in FOUR-logic and quark colour charge in FIVE-logic, with interactive state selection and probability normalisation.</h2>

<div class="sys-grid">

<div class="panel">
  <p class="panel-title">Electron orbital — FOUR logic</p>
  <p class="panel-sub">Click a state. Each node is a Belnap truth value ⟨t, f⟩ — click to select and see its normalised probability.</p>
  <svg width="100%" viewBox="0 0 300 260" id="four-svg">
    <defs>
      <marker id="a4" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </marker>
    </defs>
    <line x1="68" y1="60" x2="232" y2="60"  stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3" marker-end="url(#a4)"/>
    <line x1="68" y1="200" x2="232" y2="200" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3" marker-end="url(#a4)"/>
    <line x1="60" y1="192" x2="60"  y2="68"  stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3" marker-end="url(#a4)"/>
    <line x1="240" y1="192" x2="240" y2="68" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3" marker-end="url(#a4)"/>
    <text x="150" y="247" text-anchor="middle" class="ts" fill="var(--color-text-tertiary)">knowledge ⊑k (f-axis)</text>
    <text x="14" y="133" text-anchor="middle" class="ts" fill="var(--color-text-tertiary)" transform="rotate(-90,14,133)">truth ⊑t</text>

    <g id="n4-N" class="node" onclick="selectFour('N')" style="cursor:pointer">
      <circle cx="60" cy="200" r="28" fill="#D3D1C7" stroke="#5F5E5A" stroke-width="0.5"/>
      <text x="60" y="195" text-anchor="middle" dominant-baseline="central" class="th" fill="#2C2C2A">∅</text>
      <text x="60" y="211" text-anchor="middle" class="ts" fill="#444441">empty</text>
    </g>
    <g id="n4-T" class="node" onclick="selectFour('T')" style="cursor:pointer">
      <circle cx="60" cy="60" r="28" fill="#B5D4F4" stroke="#185FA5" stroke-width="0.5"/>
      <text x="60" y="53" text-anchor="middle" dominant-baseline="central" class="th" fill="#042C53">↑</text>
      <text x="60" y="70" text-anchor="middle" class="ts" fill="#0C447C">spin-up</text>
    </g>
    <g id="n4-F" class="node" onclick="selectFour('F')" style="cursor:pointer">
      <circle cx="240" cy="200" r="28" fill="#F7C1C1" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="240" y="193" text-anchor="middle" dominant-baseline="central" class="th" fill="#501313">↓</text>
      <text x="240" y="210" text-anchor="middle" class="ts" fill="#791F1F">spin-down</text>
    </g>
    <g id="n4-B" class="node" onclick="selectFour('B')" style="cursor:pointer">
      <circle cx="240" cy="60" r="28" fill="#FAC775" stroke="#854F0B" stroke-width="0.5"/>
      <text x="240" y="53" text-anchor="middle" dominant-baseline="central" class="th" fill="#412402">↑↓</text>
      <text x="240" y="70" text-anchor="middle" class="ts" fill="#633806">paired</text>
    </g>
    <text x="14" y="204" class="ts" fill="var(--color-text-tertiary)">N</text>
    <text x="14" y="64"  class="ts" fill="var(--color-text-tertiary)">T</text>
    <text x="260" y="204" class="ts" fill="var(--color-text-tertiary)">F</text>
    <text x="260" y="64"  class="ts" fill="var(--color-text-tertiary)">B</text>
  </svg>
  <div class="info-box" id="four-info">
    <p class="info-label">select a state above</p>
    <p class="info-val" id="four-text">Click any orbital node to see its logical coordinates, weight decomposition, and normalised probability.</p>
    <div id="four-prob" style="display:none">
      <div class="prob-row">
        <span class="prob-label">P</span>
        <div class="prob-bar-wrap"><div class="prob-bar" id="four-bar" style="width:0%;background:#185FA5"></div></div>
        <span class="prob-num" id="four-pnum">—</span>
      </div>
    </div>
  </div>
</div>

<div class="panel">
  <p class="panel-title">Quark colour charge — FIVE logic</p>
  <p class="panel-sub">Three equal-weight middle values between two terminals. No linear order exists — frustration is structural.</p>
  <svg width="100%" viewBox="0 0 300 260" id="five-svg">
    <defs>
      <marker id="a5" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </marker>
    </defs>
    <line x1="150" y1="38" x2="83"  y2="145" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3"/>
    <line x1="150" y1="38" x2="150" y2="145" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3"/>
    <line x1="150" y1="38" x2="217" y2="145" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3"/>
    <line x1="83"  y1="145" x2="150" y2="222" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3"/>
    <line x1="150" y1="145" x2="150" y2="222" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3"/>
    <line x1="217" y1="145" x2="150" y2="222" stroke="#888780" stroke-width="0.5" stroke-dasharray="3 3"/>
    <line id="frust-R-G" x1="83"  y1="145" x2="150" y2="145" stroke="#E24B4A" stroke-width="1" stroke-dasharray="2 2" opacity="0"/>
    <line id="frust-G-B" x1="150" y1="145" x2="217" y2="145" stroke="#E24B4A" stroke-width="1" stroke-dasharray="2 2" opacity="0"/>
    <line id="frust-R-B" x1="83"  y1="145" x2="217" y2="145" stroke="#E24B4A" stroke-width="1" stroke-dasharray="2 2" opacity="0"/>

    <g id="n5-W" class="node" onclick="selectFive('W')" style="cursor:pointer">
      <circle cx="150" cy="30" r="26" fill="#D3D1C7" stroke="#5F5E5A" stroke-width="0.5"/>
      <text x="150" y="24" text-anchor="middle" dominant-baseline="central" class="th" fill="#2C2C2A">W</text>
      <text x="150" y="40" text-anchor="middle" class="ts" fill="#444441">colorless</text>
    </g>
    <g id="n5-R" class="node" onclick="selectFive('R')" style="cursor:pointer">
      <circle cx="83" cy="145" r="26" fill="#F7C1C1" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="83" y="139" text-anchor="middle" dominant-baseline="central" class="th" fill="#501313">R</text>
      <text x="83" y="155" text-anchor="middle" class="ts" fill="#791F1F">red</text>
    </g>
    <g id="n5-G" class="node" onclick="selectFive('G')" style="cursor:pointer">
      <circle cx="150" cy="145" r="26" fill="#C0DD97" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="150" y="139" text-anchor="middle" dominant-baseline="central" class="th" fill="#173404">G</text>
      <text x="150" y="155" text-anchor="middle" class="ts" fill="#27500A">green</text>
    </g>
    <g id="n5-B" class="node" onclick="selectFive('B')" style="cursor:pointer">
      <circle cx="217" cy="145" r="26" fill="#B5D4F4" stroke="#185FA5" stroke-width="0.5"/>
      <text x="217" y="139" text-anchor="middle" dominant-baseline="central" class="th" fill="#042C53">B</text>
      <text x="217" y="155" text-anchor="middle" class="ts" fill="#0C447C">blue</text>
    </g>
    <g id="n5-A" class="node" onclick="selectFive('A')" style="cursor:pointer">
      <circle cx="150" cy="222" r="26" fill="#FAC775" stroke="#854F0B" stroke-width="0.5"/>
      <text x="150" y="216" text-anchor="middle" dominant-baseline="central" class="th" fill="#412402">A</text>
      <text x="150" y="231" text-anchor="middle" class="ts" fill="#633806">anti-color</text>
    </g>
  </svg>
  <div class="info-box" id="five-info">
    <p class="info-label">select a state above</p>
    <p class="info-val" id="five-text">Click a quark colour node to see its lattice position, weights, and frustration state.</p>
    <div id="five-prob" style="display:none">
      <div class="prob-row">
        <span class="prob-label">P</span>
        <div class="prob-bar-wrap"><div class="prob-bar" id="five-bar" style="width:50%;background:#888780"></div></div>
        <span class="prob-num" id="five-pnum">—</span>
      </div>
    </div>
    <div class="frustration-bar" id="frust-label">Frustration: inactive</div>
  </div>
</div>

</div>

<hr class="divider">

<div class="comparison">
  <div class="cmp-card">
    <p class="cmp-card-title">Shared structure</p>
    <p class="cmp-card-body">Both are bounded lattices with a bottom (no evidence / empty / anti-color) and a top (full evidence / paired / colorless). The middle values are the interesting physics.</p>
  </div>
  <div class="cmp-card">
    <p class="cmp-card-title">Hund's rule = ⊑k preference</p>
    <p class="cmp-card-body">Electrons prefer T or F over N before accepting B — half-fill before pairing. In FOUR terms: maximise information content (⊑k) before accepting contradictory evidence (B).</p>
  </div>
  <div class="cmp-card">
    <p class="cmp-card-title">Confinement = frustration resolved</p>
    <p class="cmp-card-body">A free quark is frustrated — it has a colour charge with no consistent linear ordering. Confinement forces R+G+B into a colourless (W) baryon, collapsing the frustrated triad to the top of the lattice.</p>
  </div>
</div>

<button style="margin-top:1rem;font-size:13px" onclick="sendPrompt('Can you extend this further — what logic would describe gluon colour-anticolour pairs, or the 8 gluon states of SU(3)?')">Extend to gluons and SU(3) ↗</button>

</div>

<script>
const fourData = {
  N: {label:'∅ — empty',coords:'⟨0, 0⟩',t:0,f:0,phys:'No electrons. Zero information content. Probability undefined — no evidence received. Lowest on both orderings.',barColor:'#888780'},
  T: {label:'↑ — spin-up',coords:'⟨1, 0⟩',t:1,f:0,phys:'One electron, spin +½. Pure positive evidence. P = 1. First electron enters by Hund\'s rule — half-fill before pairing.',barColor:'#185FA5'},
  F: {label:'↓ — spin-down',coords:'⟨0, 1⟩',t:0,f:1,phys:'One electron, spin −½. Pure negative evidence. P = 0. Equivalent information content to ↑, opposite truth direction.',barColor:'#A32D2D'},
  B: {label:'↑↓ — paired',coords:'⟨1, 1⟩',t:1,f:1,phys:'Two electrons, opposite spins. Contradictory evidence — forced by Pauli exclusion. P = 0.5. Maximum information, zero net truth lean.',barColor:'#854F0B'},
};

const fiveData = {
  W: {label:'W — colorless (top)',coords:'terminal, ⊤',t:1,f:0,p:1,phys:'Colorless / white. The top terminal — maximum "truth". A baryon (R+G+B) or meson (C+C̄) neutralises to this. Confinement\'s goal state. P = 1.',barColor:'#5F5E5A',frustration:false},
  R: {label:'R — red',coords:'middle, weight 1/3',t:0.333,f:0.333,p:0.5,phys:'Red colour charge. Equal weight among the three middle nodes — no order relation to G or B. Cannot be compared on the truth ordering: that\'s frustration. P = 0.5.',barColor:'#A32D2D',frustration:true},
  G: {label:'G — green',coords:'middle, weight 1/3',t:0.333,f:0.333,p:0.5,phys:'Green colour charge. Structurally identical weight to R and B. The three middles form an antichain — no node is above another under ⊑t. P = 0.5.',barColor:'#3B6D11',frustration:true},
  B: {label:'B — blue',coords:'middle, weight 1/3',t:0.333,f:0.333,p:0.5,phys:'Blue colour charge. Same weight as R and G. In a frustrated system (e.g. a triangle of quarks), you cannot consistently assign a total order — at least one pair violates any ordering you try. P = 0.5.',barColor:'#185FA5',frustration:true},
  A: {label:'A — anti-color (bottom)',coords:'terminal, ⊥',t:0,f:1,p:0,phys:'Anti-colorless. The bottom terminal — minimum "truth". A hypothetical state of complete color anti-charge. P = 0. Mirror image of W under the truth ordering.',barColor:'#854F0B',frustration:false},
};

let selFour = null, selFive = null;

function selectFour(key) {
  selFour = key;
  ['N','T','F','B'].forEach(k => {
    const g = document.getElementById('n4-'+k);
    g.style.opacity = (k === key) ? '1' : '0.4';
  });
  const d = fourData[key];
  const sum = d.t + d.f;
  const p = sum < 0.001 ? null : d.t / sum;
  document.getElementById('four-text').textContent = d.coords + ' — ' + d.phys;
  document.querySelector('#four-info .info-label').textContent = d.label;
  const probDiv = document.getElementById('four-prob');
  probDiv.style.display = 'block';
  const bar = document.getElementById('four-bar');
  const pnum = document.getElementById('four-pnum');
  if (p === null) {
    bar.style.width = '0%'; bar.style.background = '#888780'; pnum.textContent = 'undef';
  } else {
    bar.style.width = (p*100).toFixed(0)+'%'; bar.style.background = d.barColor; pnum.textContent = p.toFixed(2);
  }
}

function selectFive(key) {
  selFive = key;
  ['W','R','G','B','A'].forEach(k => {
    document.getElementById('n5-'+k).style.opacity = (k === key) ? '1' : '0.4';
  });
  const d = fiveData[key];
  document.getElementById('five-text').textContent = d.coords + ' — ' + d.phys;
  document.querySelector('#five-info .info-label').textContent = d.label;
  const probDiv = document.getElementById('five-prob');
  probDiv.style.display = 'block';
  const bar = document.getElementById('five-bar');
  const pnum = document.getElementById('five-pnum');
  bar.style.width = (d.p*100).toFixed(0)+'%';
  bar.style.background = d.barColor;
  pnum.textContent = d.p.toFixed(2);

  const fl = document.getElementById('frust-label');
  ['frust-R-G','frust-G-B','frust-R-B'].forEach(id => {
    document.getElementById(id).setAttribute('opacity','0');
  });
  if (d.frustration) {
    fl.textContent = 'Frustration: active — R, G, B form an antichain. No consistent total order exists.';
    fl.classList.add('active');
    document.getElementById('frust-R-G').setAttribute('opacity','1');
    document.getElementById('frust-G-B').setAttribute('opacity','1');
    document.getElementById('frust-R-B').setAttribute('opacity','1');
  } else {
    fl.textContent = key === 'W'
      ? 'Frustration: resolved — colorless top node. Confinement achieved.'
      : 'Frustration: resolved — anti-color bottom node. Symmetric opposite of W.';
    fl.classList.remove('active');
  }
}
</script>
