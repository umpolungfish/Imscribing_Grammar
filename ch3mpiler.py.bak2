#!/usr/bin/env python3
"""ch3mpiler - Retrosynthetic/Forward Reaction Compiler
Grounded in the Imscribing Grammar 12-primitive structural types.
USES GRAMMAR-DERIVED BOND FORMATION RULES — no named reactions.

The retrosynthesis engine uses the grammar's lattice operations (meet,
join, tensor) to determine which bonds can be formed or disconnected
based on structural compatibility of functional groups, not human-named
reactions. Each bond type has a 12-primitive structural signature. The
derived rules compute which FG pairs can connect via which bond types,
and rank disconnections by structural delta.

Author: Lando \u2297 \u2299perator
"""
import argparse, json, math, os, re, sys, urllib.request, urllib.error, time
from collections import Counter, defaultdict
from pathlib import Path

BASE = Path(__file__).parent.absolute()
CATALOG_PATH = BASE / "IG_catalog.json"
CAS_CACHE_PATH = BASE / "CAS_cache.json"
sys.path.insert(0, str(BASE))

from space_search.primitives import ORDINALS, WEIGHTS, resolve_ordinal_key

PNAMES = ["D","T","R","P","F","K","G","Gm","Ph","H","S","W"]
PFIELDS = ["D","T","R","P","F","K","G","Gm","Ph","H","S","W"]
FIELD_TO_ORD = {
    "D":"\u00D0", "T":"\u00de", "R":"\u0158", "P":"\u03a6", "F":"\u0192",
    "K":"\u00c7", "G":"\u0393", "Gm":"\u0262", "Ph":"\u2299", "H":"\u0126",
    "S":"\u03a3", "W":"\u03a9"
}

def g2v(p, r):
    """Primitive glyph \u2192 ordinal value."""
    ord_key = FIELD_TO_ORD.get(p, p)
    om = ORDINALS.get(ord_key, {})
    if r in om:
        return r, om[r]
    try:
        k = resolve_ordinal_key(ord_key, r)
        return k, om[k]
    except Exception:
        return r, 0

def tup_from_dict(d):
    return {pn: g2v(pn, d.get(pf, ""))[0] for pn, pf in zip(PNAMES, PFIELDS)}

def fmt_tup(t):
    gs = [t.get(p, "?") for p in PNAMES]
    return "<" + "; ".join(gs) + ">"

def tup_dist(t1, t2):
    sq = 0.0; cf = []
    for p in PNAMES:
        v1 = t1.get(p, ""); v2 = t2.get(p, "")
        _, o1 = g2v(p, v1); _, o2 = g2v(p, v2)
        w = WEIGHTS.get(p if p != "W" else "\u03a9", 1.0)
        d = (o1 - o2) * w; sq += d * d
        if o1 != o2:
            cf.append({"p": p, "a": v1, "b": v2, "d": o1 - o2})
    return math.sqrt(sq), cf

def compose_tensor(t1, t2):
    """Grammar tensor product of two structural types.
    Max on union primitives, min on P and F.
    Returns new tuple dict and distance from each input."""
    result = {}
    for p in PNAMES:
        _, o1 = g2v(p, t1.get(p, "?")); _, o2 = g2v(p, t2.get(p, "?"))
        if p in ("P", "F"):
            result[p] = t1.get(p, "?") if o1 <= o2 else t2.get(p, "?")
        else:
            result[p] = t1.get(p, "?") if o1 >= o2 else t2.get(p, "?")
    return result

def compose_meet(t1, t2):
    """Grammar meet (greatest lower bound) of two structural types.
    Min on all primitives."""
    result = {}
    for p in PNAMES:
        _, o1 = g2v(p, t1.get(p, "?")); _, o2 = g2v(p, t2.get(p, "?"))
        result[p] = t1.get(p, "?") if o1 <= o2 else t2.get(p, "?")
    return result

def compose_join(t1, t2):
    """Grammar join (least upper bound) of two structural types.
    Max on all primitives."""
    result = {}
    for p in PNAMES:
        _, o1 = g2v(p, t1.get(p, "?")); _, o2 = g2v(p, t2.get(p, "?"))
        result[p] = t1.get(p, "?") if o1 >= o2 else t2.get(p, "?")
    return result
