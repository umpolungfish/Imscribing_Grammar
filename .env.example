# Imscribing Grammar Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Required
# =============================================================================

# OpenRouter API key — get one free at https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Model to use for the agent loop (must be set; no default)
# Examples:
#   google/gemini-2.0-flash-001
#   deepseek/deepseek-chat-v3-0324
#   meta-llama/llama-4-maverick
IG_PROVIDER="openrouter/your-model-here"

# Model ID passed to the provider (overrides provider default)
# Examples:
#   google/gemini-2.5-pro
#   deepseek/deepseek-chat-v3-0324
IG_MODEL="google/gemini-2.5-pro"

# =============================================================================
# Optional provider keys
# =============================================================================

# DeepSeek (direct)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# =============================================================================
# Aider Configuration (Git-native AI pair programming)
# =============================================================================
# Note: OpenRouter FREE MODELS require a FREE API key (no credits needed).
# Get your free key at: https://openrouter.ai/keys

# OpenRouter API Key (FREE - required even for free models)
OPENROUTER_API_KEY="your-free-openrouter-api-key-here"

# Aider Model Selection (default: NVIDIA Nemotron Nano - free, efficient)
AIDER_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# Recommended Free Models (with free API key):
# - nvidia/nemotron-3-nano-30b-a3b:free (RECOMMENDED - efficient, 256K context)
# - nvidia/nemotron-3-super-120b-a12b:free (120B MoE, 262K context)
# - openrouter/hunter-alpha (1T params, 1M+ context)
# - arcee-ai/trinity-mini:free (26B MoE, efficient)

# Premium Models (require OPENROUTER_API_KEY with credits):
# - claude-sonnet-4-5-20250929
# - deepseek-chat

# Aider Git Configuration
AIDER_AUTO_COMMITS="true"       # Auto-commit changes with descriptive messages
AIDER_SHOW_DIFFS="true"         # Show diffs before committing
AIDER_USE_GIT="true"            # Use Git for version control
AIDER_DIRTY_COMMITS="true"      # Commit uncommitted changes before new edits
AIDER_DRY_RUN="false"           # Show what would be done without making changes

# Aider Code Quality
AIDER_AUTO_LINT="true"          # Auto-lint after changes
AIDER_AUTO_TEST="false"         # Auto-test after changes (requires AIDER_TEST_COMMAND)
AIDER_TEST_COMMAND=""           # Test command to run (e.g., "python test_integration.py")

# Aider UI/UX
AIDER_PRETTY="true"             # Pretty output formatting
AIDER_AUTO_ACCEPT="false"       # Auto-accept changes without confirmation
AIDER_VERBOSE="false"           # Verbose logging

# =============================================================================
# Agent / CLI Configuration
# =============================================================================

# Default max tokens for generation
SYNTHONICON_MAX_TOKENS=4000

# Default temperature for generation (lower = more deterministic)
SYNTHONICON_TEMPERATURE=0.3

# Catalog storage path (default: ~/.synthomnicon/catalog.json)
SYNTHONICON_CATALOG_PATH=""

# =============================================================================
# Optional: Local Model Configuration (Ollama)
# =============================================================================

# Ollama base URL (if running locally)
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama model to use with Aider
AIDER_OLLAMA_MODEL="llama3"
