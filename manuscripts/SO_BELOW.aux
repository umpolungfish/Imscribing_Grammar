\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Grammar architecture and Frobenius foundation.} Four-layer imscription pipeline. The observer $\boldsymbol  {\text  {{\primfont ⊡}}}$ carries the self-imscribed tuple $\langle S \rangle $ (the grammar applied to itself, $O_\infty $ tier, address 6,734,591). The semantic field $\boldsymbol  {\mitSigma }$ is the Crystal of Types: the graph $G=(V,E,\mitphi )$ of 17,280,000 structural positions. The transformation layer $\mittau $ implements the three algebraic operations --- tensor product $\otimes $, lattice meet/join $\wedge /\vee $, and directed distance $d_\to $. The perceptual input $\boldsymbol  {\mitPi }$ is the target system $I(t)$. The downward arrow $\mitdelta $ is the co-multiplication: the grammar encodes its own structure into the Crystal. The curved return arrow $\mitmu $ is the multiplication: the Crystal recovers the grammar. Their composition $\mitmu \circ \mitdelta = \mathrm {id}$ is the special Frobenius condition (\Cref  {sec:frobenius}) --- the foundational algebraic constraint that makes $O_\infty $ non-synthesizable and determines the entire tier hierarchy.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:architecture}{{2}{7}{\textbf {Grammar architecture and Frobenius foundation.} Four-layer imscription pipeline. The observer $\boldsymbol {\text {{\igprimfont ⊡}}}$ carries the self-imscribed tuple $\langle S \rangle $ (the grammar applied to itself, $O_\infty $ tier, address 6,734,591). The semantic field $\boldsymbol {\Sigma }$ is the Crystal of Types: the graph $G=(V,E,\phi )$ of 17,280,000 structural positions. The transformation layer $\tau $ implements the three algebraic operations --- tensor product $\otimes $, lattice meet/join $\wedge /\vee $, and directed distance $d_\to $. The perceptual input $\boldsymbol {\Pi }$ is the target system $I(t)$. The downward arrow $\delta $ is the co-multiplication: the grammar encodes its own structure into the Crystal. The curved return arrow $\mu $ is the multiplication: the Crystal recovers the grammar. Their composition $\mu \circ \delta = \mathrm {id}$ is the special Frobenius condition (\Cref {sec:frobenius}) --- the foundational algebraic constraint that makes $O_\infty $ non-synthesizable and determines the entire tier hierarchy}{figure.5}{}}
\newlabel{fig:architecture@cref}{{[figure][2][]2}{[1][6][]7}}
