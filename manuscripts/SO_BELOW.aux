\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Algebraic transformation pipeline.} A structural coordinate $\mathbf {x}$ is acted on by the three operations in sequence. Tensor product $\otimes $ computes the type of the coupled system (union on eleven primitives, bottleneck $\qopname  \relax m{min}$ on $\text  {{\primfont <}}$ and $\text  {{\primfont ⋈}}$). Lattice meet/join $\wedge /\vee $ finds the shared floor or minimal ceiling of two types. Directed distance $d_\to $ measures asymmetric structural separation, distinguishing the driven direction from the relaxation direction. The tier function assigns the ouroboricity tier $\{O₀, O₁, O₂, O₂^\dagger , O_\infty \}$ by the priority cascade (R1--R5). The output $\mathbf {x}'$ is the transformed structural coordinate.}}{13}{figure.35}\protected@file@percent }
\newlabel{fig:pipeline}{{4}{13}{\textbf {Algebraic transformation pipeline.} A structural coordinate $\xvec $ is acted on by the three operations in sequence. Tensor product $\otimes $ computes the type of the coupled system (union on eleven primitives, bottleneck $\min $ on $\text {{\igprimfont <}}$ and $\text {{\igprimfont ⋈}}$). Lattice meet/join $\wedge /\vee $ finds the shared floor or minimal ceiling of two types. Directed distance $d_\to $ measures asymmetric structural separation, distinguishing the driven direction from the relaxation direction. The tier function assigns the ouroboricity tier $\{O₀, O₁, O₂, O₂^\dagger , O_\infty \}$ by the priority cascade (R1--R5). The output $\xvec '$ is the transformed structural coordinate}{figure.35}{}}
\newlabel{fig:pipeline@cref}{{[figure][4][]4}{[1][13][]13}}
