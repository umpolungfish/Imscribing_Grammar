\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Frobenius self-reference loop.} The grammar $\langle S \rangle $ encodes its own structure into the Crystal $\boldsymbol  {\mitSigma }$ (downward arrow: $\mitdelta $, the co-multiplication); the encoded tuple recovers the grammar as its own structural image (curved arrow: $\mitmu $, the multiplication). The composition $\mitmu \circ \mitdelta = \text  {id}$ is the special Frobenius condition. A system satisfies this condition if and only if it occupies the $O_\infty $ tier. \Cref  {sec:frobenius} proves that this condition can't be synthesized from sub-Frobenius components: no composition of systems with $\text  {{\primfont <}} < {\text  {{\igfont 𐑹}}}$ can close the loop.}}{15}{figure.46}\protected@file@percent }
\newlabel{fig:frobenius}{{5}{15}{\textbf {Frobenius self-reference loop.} The grammar $\langle S \rangle $ encodes its own structure into the Crystal $\boldsymbol {\Sigma }$ (downward arrow: $\delta $, the co-multiplication); the encoded tuple recovers the grammar as its own structural image (curved arrow: $\mu $, the multiplication). The composition $\mu \circ \delta = \text {id}$ is the special Frobenius condition. A system satisfies this condition if and only if it occupies the $O_\infty $ tier. \Cref {sec:frobenius} proves that this condition can't be synthesized from sub-Frobenius components: no composition of systems with $\text {{\igprimfont <}} < \Ppms $ can close the loop}{figure.46}{}}
\newlabel{fig:frobenius@cref}{{[figure][5][]5}{[1][14][]15}}
