<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Belnap's Bilattice • Probability Normalisation</title>
<style>
  :root {
    --bg-primary: #0f0c08;
    --bg-secondary: #1c1812;
    --bg-card: #211d19;
    --text-primary: #f5e8c7;
    --text-secondary: #d4c9a8;
    --text-tertiary: #a89f8a;
    --accent-gold: #d4af37;
    --truth-teal: #3e7a8c;
    --false-crimson: #8c2f2f;
    --both-amber: #b38b2e;
    --neither-stone: #6b6659;
    --border: #3f3a32;
  }
  body { margin:0; background:var(--bg-primary); color:var(--text-primary); font-family:system-ui,-apple-system,sans-serif; }
  .root{padding:1.5rem 1rem;font-size:14px;color:var(--text-primary);max-width:960px;margin:auto;}
  .section-title{font-size:18px;font-weight:500;margin:0 0 .75rem;color:var(--accent-gold);border-bottom:1px solid var(--border);padding-bottom:0.5rem;}
  .sub-title{font-size:13px;color:var(--text-secondary);margin:0 0 1.25rem;line-height:1.6}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:1.5rem}
  @media(max-width:520px){.two-col{grid-template-columns:1fr}}
  .card{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:1.25rem;}
  .badge{display:inline-block;font-size:11px;font-weight:500;padding:3px 10px;border-radius:4px;margin-right:6px}
  .badge-t{background:#2a4f5e;color:#9ed4e0}
  .badge-f{background:#5c2a2a;color:#e8a8a8}
  .badge-b{background:#664d2a;color:#e8d4a8}
  .badge-n{background:#4a453a;color:#c8c0b0}
  .slider-row{display:flex;align-items:center;gap:10px;margin:.5rem 0}
  .slider-row label{font-size:13px;color:var(--text-secondary);min-width:60px}
  .slider-row input{flex:1}
  .slider-row span{font-size:13px;font-weight:500;min-width:32px;text-align:right;color:var(--accent-gold)}
  .result-box{margin-top:1rem;padding:.75rem 1rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-secondary)}
  .big-num{font-size:28px;font-weight:500;color:var(--accent-gold)}
  .bar-wrap{height:14px;background:#332e27;border-radius:7px;overflow:hidden;margin:.5rem 0}
  .bar-fill{height:14px;border-radius:7px;transition:width .25s}
  .formula{font-family:monospace;font-size:12px;color:var(--text-tertiary);margin-top:.4rem}
  .divider{border:none;border-top:1px solid var(--border);margin:1.25rem 0}
  .row-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--text-tertiary);margin-top:2px}
</style>
<div class="root">
  <h2 class="sr-only">Belnap's bilattice: truth values as weight carriers that normalise to probabilities</h2>

  <p class="section-title">Belnap's FOUR as a unit square</p>
  <p class="sub-title">Each truth value is a point ⟨t, f⟩ ∈ {0,1}². The two orderings are independent axes.</p>

  <svg width="100%" viewBox="0 0 680 280" role="img">
    <title>Belnap bilattice square diagram</title>
    <desc>Four truth values arranged as corners of a square. N at bottom-left, T at top-left, F at bottom-right, B at top-right.</desc>
    <defs>
      <marker id="arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </marker>
    </defs>

    <rect x="190" y="50" width="200" height="180" rx="4" fill="none" stroke="#3f3a32" stroke-width="0.5" stroke-dasharray="4 3"/>

    <text x="340" y="262" text-anchor="middle" font-size="11" fill="#a89f8a">← f-component (told false) →</text>
    <text x="168" y="142" text-anchor="middle" font-size="11" fill="#a89f8a" transform="rotate(-90,168,142)">← t-component (told true) →</text>

    <text x="190" y="247" text-anchor="middle" font-size="10" fill="#a89f8a">0</text>
    <text x="390" y="247" text-anchor="middle" font-size="10" fill="#a89f8a">1</text>
    <text x="178" y="238" text-anchor="end" font-size="10" fill="#a89f8a">0</text>
    <text x="178" y="58" text-anchor="end" font-size="10" fill="#a89f8a">1</text>

    <line x1="198" y1="230" x2="382" y2="230" stroke="#b38b2e" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#arr2)"/>
    <line x1="198" y1="58" x2="382" y2="58" stroke="#b38b2e" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#arr2)"/>
    <line x1="198" y1="222" x2="198" y2="68" stroke="#3e7a8c" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#arr2)"/>
    <line x1="388" y1="222" x2="388" y2="68" stroke="#3e7a8c" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#arr2)"/>

    <line x1="460" y1="90" x2="490" y2="90" stroke="#b38b2e" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#arr2)"/>
    <text x="498" y="94" font-size="11" fill="#d4c9a8">knowledge ⊑k</text>
    <line x1="460" y1="114" x2="490" y2="114" stroke="#3e7a8c" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#arr2)"/>
    <text x="498" y="118" font-size="11" fill="#d4c9a8">truth ⊑t</text>

    <!-- N -->
    <g><circle cx="190" cy="230" r="20" fill="#6b6659" stroke="#3f3a32" stroke-width="0.5"/><text x="190" y="226" text-anchor="middle" dominant-baseline="central" font-size="13" font-weight="500" fill="#f5e8c7">N</text><text x="190" y="240" text-anchor="middle" font-size="9" fill="#a89f8a">⟨0,0⟩</text></g>
    <!-- T -->
    <g><circle cx="190" cy="58" r="20" fill="#3e7a8c" stroke="#d4af37" stroke-width="0.5"/><text x="190" y="54" text-anchor="middle" dominant-baseline="central" font-size="13" font-weight="500" fill="#f5e8c7">T</text><text x="190" y="68" text-anchor="middle" font-size="9" fill="#d4c9a8">⟨1,0⟩</text></g>
    <!-- F -->
    <g><circle cx="390" cy="230" r="20" fill="#8c2f2f" stroke="#d4af37" stroke-width="0.5"/><text x="390" y="226" text-anchor="middle" dominant-baseline="central" font-size="13" font-weight="500" fill="#f5e8c7">F</text><text x="390" y="240" text-anchor="middle" font-size="9" fill="#d4c9a8">⟨0,1⟩</text></g>
    <!-- B -->
    <g><circle cx="390" cy="58" r="20" fill="#b38b2e" stroke="#d4af37" stroke-width="0.5"/><text x="390" y="54" text-anchor="middle" dominant-baseline="central" font-size="13" font-weight="500" fill="#f5e8c7">B</text><text x="390" y="68" text-anchor="middle" font-size="9" fill="#d4c9a8">⟨1,1⟩</text></g>

    <text x="130" y="234" text-anchor="end" font-size="11" fill="#d4c9a8">Neither</text>
    <text x="130" y="62" text-anchor="end" font-size="11" fill="#d4c9a8">True</text>
    <text x="450" y="234" text-anchor="start" font-size="11" fill="#d4c9a8">False</text>
    <text x="450" y="62" text-anchor="start" font-size="11" fill="#d4c9a8">Both</text>
  </svg>

  <hr class="divider">

  <p class="section-title">From weights to probability</p>
  <p class="sub-title">Treat t and f as raw <em>support weights</em>. When t + f > 0, normalise: P = t / (t + f).</p>

  <div class="two-col">
    <div class="card">
      <div style="font-weight:500;margin-bottom:.5rem;color:var(--accent-gold)">Adjust weights</div>
      <div class="slider-row">
        <label>t (true)</label>
        <input type="range" min="0" max="100" value="70" id="sl-t" step="1" oninput="update()">
        <span id="lbl-t">0.70</span>
      </div>
      <div class="slider-row">
        <label>f (false)</label>
        <input type="range" min="0" max="100" value="30" id="sl-f" step="1" oninput="update()">
        <span id="lbl-f">0.30</span>
      </div>
    </div>

    <div class="card">
      <div style="font-weight:500;margin-bottom:.75rem;color:var(--accent-gold)">Normalised probability</div>
      <div id="prob-display" class="big-num">0.700</div>
      <div class="bar-wrap"><div id="prob-bar" class="bar-fill" style="width:70%;background:#3e7a8c"></div></div>
      <div class="row-labels"><span>0</span><span>0.5</span><span>1</span></div>
      <div class="formula" id="formula-display">P = 0.70 / (0.70 + 0.30) = 0.700</div>
      <div id="value-badge" style="margin-top:.75rem"></div>
    </div>
  </div>

  <div class="result-box" id="interp-box">
    <div id="interp-text" style="font-size:13px;line-height:1.6;color:var(--text-secondary)"></div>
  </div>
</div>

<script>
const CORNERS = [{t:0,f:0,label:'N — Neither',badge:'badge-n',interp:'No evidence received. Probability is undefined — the proposition is epistemically invisible.'},
  {t:1,f:0,label:'T — True',badge:'badge-t',interp:'Only positive evidence. P = 1. Classical truth: all sources agree it holds.'},
  {t:0,f:1,label:'F — False',badge:'badge-f',interp:'Only negative evidence. P = 0. Classical falsity: all sources agree it fails.'},
  {t:1,f:1,label:'B — Both',badge:'badge-b',interp:'Equal contradictory evidence. P = 0.5. Maximum paradox — the sources cancel.'}];

function closestCorner(t,f){ let best=null,bestDist=Infinity; for(const c of CORNERS){ const d=Math.hypot(t-c.t,f-c.f); if(d<bestDist){bestDist=d;best=c;} } return {corner:best,dist:bestDist}; }

function update(){
  const tRaw=parseInt(document.getElementById('sl-t').value)/100;
  const fRaw=parseInt(document.getElementById('sl-f').value)/100;
  document.getElementById('lbl-t').textContent=tRaw.toFixed(2);
  document.getElementById('lbl-f').textContent=fRaw.toFixed(2);

  const sum=tRaw+fRaw;
  const probBar=document.getElementById('prob-bar');
  const probDisp=document.getElementById('prob-display');
  const formulaDisp=document.getElementById('formula-display');
  const badge=document.getElementById('value-badge');
  const interp=document.getElementById('interp-text');

  if(sum<0.001){
    probDisp.textContent='—';
    probBar.style.width='50%';
    probBar.style.background='#6b6659';
    formulaDisp.textContent='P undefined (no evidence)';
    badge.innerHTML='<span class="badge badge-n">N — Neither</span>';
    interp.textContent='No evidence received. Probability is undefined.';
    return;
  }

  const p=tRaw/sum;
  probDisp.textContent=p.toFixed(3);
  probBar.style.width=(p*100).toFixed(1)+'%';

  if(p>0.66) probBar.style.background='#3e7a8c';
  else if(p<0.34) probBar.style.background='#8c2f2f';
  else probBar.style.background='#b38b2e';

  formulaDisp.textContent=`P = ${tRaw.toFixed(2)} / (${tRaw.toFixed(2)} + ${fRaw.toFixed(2)}) = ${p.toFixed(3)}`;

  const {corner,dist}=closestCorner(tRaw,fRaw);
  if(dist<0.08){
    badge.innerHTML=`<span class="badge ${corner.badge}">${corner.label}</span>`;
    interp.textContent=corner.interp;
  } else {
    const sup = sum < 0.3 ? 'Weak evidence base.' : sum > 1.4 ? 'Strong evidence base.' : 'Moderate evidence base.';
    badge.innerHTML=`<span style="font-size:12px;color:var(--text-secondary)">continuous generalisation</span>`;
    interp.textContent=`${sup} P = ${p.toFixed(3)} — ${p>0.5?'leans true':'leans false or balanced'}. Total mass: ${sum.toFixed(2)}.`;
  }
}
update();
</script>
</html>