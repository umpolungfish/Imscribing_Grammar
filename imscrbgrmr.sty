% imscrbgrmr.sty — Imscribing Grammar glyph rendering
%
% Requires XeLaTeX + fontspec.
% Load with: \usepackage{imscrbgrmr}
%
% Primary command:  \prim{family}{subtype}
%   e.g. \prim{Ω}{z}
%   Works in both text mode and math mode (wraps in \text{} automatically).
%
% Tuple display:
%   \synthtype{⊢=𐑦; ⊣=𐑶; >=𐑾; <=𐑹; ⋈=𐑐; ⊤=𐑧; ∈=𐑲; ∋=𐑠; ⊙=⊙; ⊥=𐑖; ⊞=𐑙; Ω_z}
%   \primtuple{...}   — same, for use inside $...$ or equation environments
%
% Individual shortcuts (all 49 subtypes):
%   \Dwedge \Dtri \Dinfty \Dodot
%   \Tnet \Tin \Tbow \Tbox \Todot
%   \Rsuper \Rcat \Rdag \Rlr
%   \Pasym \Ppsi \Ppm \Psym \Pfrob
%   \Fell \Feth \Fhbar
%   \Kfast \Kmod \Kslow \Ktrap \KMBL
%   \Gbeth \Ggimel \Galeph
%   \IGand \IGor \IGseq \IGbroad
%   \Phisub \Phic \Phicc \PhiEP \Phisuper
%   \Hzero \Hone \Htwo \Hinf
%   \Sone \Snn \Snm
%   \Omzero \Omtwo \Omz \Omna

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{imscrbgrmr}[2026/05/08 v1.0 Imscribing Grammar glyph rendering]

\RequirePackage{fontspec}
\RequirePackage{amsmath}
\RequirePackage{graphicx}  % for \scalebox

% Glyph font — FreeSerif covers Latin Extended, Greek, and IPA block.
% Swap for Gentium Plus if you need broader IPA coverage.
\newfontfamily\glyphfont{FreeSerif}[
  UprightFont  = FreeSerif,
  BoldFont     = FreeSerifBold,
  ItalicFont   = FreeSerifItalic,
  Ligatures    = TeX,
]

% Canonical alphabet fonts.  The twelve axis letters are set in Everson Mono,
% the Shavian values in Trabajo.  Axes still carrying the pre-Shavian
% family+subtype spelling below fall back to \glyphfont until their own pass.
\newfontfamily\primfont{Everson Mono}[Scale=1.05]
\newfontfamily\shavfont{Trabajo}[Scale=1.0]

% \axis{letter} — one of ⊢ ⊣ > < ⋈ ⊤ ∈ ∋ ⊙ ⊥ ⊞ ◻
% \shav{glyph}  — one Shavian value glyph
\newcommand{\axis}[1]{\ifmmode\text{{\primfont #1}}\else{\primfont #1}\fi}
\newcommand{\shav}[1]{\ifmmode\text{{\shavfont #1}}\else{\shavfont #1}\fi}

% ── Core rendering macro ──────────────────────────────────────────────────────
%
% \prim{family-char}{subtype-char}
%   family-char  : ⊢ ⊣ > < ⋈ ⊤ ∈ ∋ ⊙ ⊥ ⊞ Ω  (⊣ migrated; see \Ttop)
%   subtype-char : the paired TIPA glyph character
%
% The subtype is lowered and scaled to 78% — no actual subscript glyph needed.

\newcommand{\prim}[2]{%
  \ifmmode
    \text{{\glyphfont #1}\raisebox{-0.32ex}{\scalebox{0.78}{\glyphfont #2}}}%
  \else
    {\glyphfont #1}\raisebox{-0.32ex}{\scalebox{0.78}{\glyphfont #2}}%
  \fi
}

% ── Tuple display ─────────────────────────────────────────────────────────────

% \synthtype{...} — inline angle-bracket tuple; switches to math for brackets
\newcommand{\synthtype}[1]{%
  $\langle{\glyphfont #1}\rangle$%
}

% \primtuple{...} — for use inside $...$ or \[ \] environments
\newcommand{\primtuple}[1]{%
  \langle\text{{\glyphfont #1}}\rangle%
}

% ── Individual shortcuts ──────────────────────────────────────────────────────

% ⊢ — Dimensionality.  Core.lean ctor order: dead, ash, array, if'.
\newcommand{\Ddim}{\axis{⊢}}
\newcommand{\Dwedge}{\shav{𐑛}}  % dead  — wedge/local, flat sheet
\newcommand{\Dtri}{\shav{𐑨}}    % ash   — triangulated / simplicial
\newcommand{\Dinfty}{\shav{𐑼}}  % array — infinite-dimensional
\newcommand{\Dodot}{\shav{𐑦}}   % if'   — imscriptive

% ⊣ — Topology.  Core.lean ctor order: judge, eat, mime, oil, are.
\newcommand{\Ttop}{\axis{⊣}}
\newcommand{\Tnet}{\shav{𐑡}}   % judge — general graph
\newcommand{\Tin}{\shav{𐑰}}    % eat   — inclusion / nested
\newcommand{\Tbow}{\shav{𐑥}}   % mime  — bowtie / figure-8
\newcommand{\Tbox}{\shav{𐑶}}   % oil   — box / lattice
\newcommand{\Todot}{\shav{𐑸}}  % are   — imscriptive

% > — Relational.  Core.lean ctor order: ado, tot, ear, ian.
\newcommand{\Rrel}{\axis{>}}
\newcommand{\Rsuper}{\shav{𐑩}}  % ado — supervisory / hierarchical
\newcommand{\Rcat}{\shav{𐑑}}    % tot — categorical / compositional
\newcommand{\Rdag}{\shav{𐑽}}    % ear — dagger / reciprocal
\newcommand{\Rlr}{\shav{𐑾}}     % ian — lateral / peer

% < — Polarity.  Core.lean ctor order: church, yew, out, nun, or'.
\newcommand{\Ppol}{\axis{<}}
\newcommand{\Pasym}{\shav{𐑗}}   % church — asymmetric, no symmetry axis
\newcommand{\Ppsi}{\shav{𐑿}}    % yew    — phase symmetry, U(1)
\newcommand{\Ppm}{\shav{𐑬}}     % out    — ℤ₂ discrete, sign flip
\newcommand{\Psym}{\shav{𐑯}}    % nun    — full continuous symmetry
\newcommand{\Pfrob}{\shav{𐑹}}   % or'    — Special Frobenius, μ∘δ=id

% ⋈ — Fidelity.  Core.lean ctor order: age, they, peep.
\newcommand{\Ffid}{\axis{⋈}}
\newcommand{\Fell}{\shav{𐑱}}    % age  — classical search fidelity (ℓ)
\newcommand{\Feth}{\shav{𐑞}}    % they — HotSwap threshold (η)
\newcommand{\Fhbar}{\shav{𐑐}}   % peep — quantum / high fidelity (ℏ)

% ⊤ — Kinetics.  Core.lean ctor order: yea, loll, egg, on, air.
\newcommand{\Kkin}{\axis{⊤}}
\newcommand{\Kfast}{\shav{𐑘}}   % yea  — diffusion-limited, untrapped
\newcommand{\Kmod}{\shav{𐑤}}    % loll — moderate barrier
\newcommand{\Kslow}{\shav{𐑧}}   % egg  — slow / thermally activated
\newcommand{\Ktrap}{\shav{𐑪}}   % on   — kinetically trapped by order
\newcommand{\KMBL}{\shav{𐑺}}    % air  — many-body localized

% ∈ — Granularity.  Core.lean ctor order: bib, thigh, ice.
\newcommand{\Ggran}{\axis{∈}}
\newcommand{\Gbeth}{\shav{𐑚}}   % bib   — local / mesoscale (ℶ)
\newcommand{\Ggimel}{\shav{𐑔}}  % thigh — intermediate / collective (ℷ)
\newcommand{\Galeph}{\shav{𐑲}}  % ice   — global / fine-grained (ℵ)

% ∋ — Grammar.  Core.lean ctor order: vow, gag, measure, ooze.
\newcommand{\IGgram}{\axis{∋}}
\newcommand{\IGand}{\shav{𐑝}}    % vow     — conjunctive, all required
\newcommand{\IGor}{\shav{𐑜}}     % gag     — disjunctive, any sufficient
\newcommand{\IGseq}{\shav{𐑠}}    % measure — sequential / ordered
\newcommand{\IGbroad}{\shav{𐑵}}  % ooze    — broadcast, one-to-all

% ⊙ — Criticality.  Core.lean ctor order: woe, monad, roar, err, haha.
% The axis letter never moved, and monad's value is the letter itself.
\newcommand{\Phcrit}{\axis{⊙}}
\newcommand{\Phisub}{\shav{𐑢}}    % woe   — subcritical, stable
\newcommand{\Phic}{\axis{⊙}}      % monad — the real-axis critical point
\newcommand{\Phicc}{\shav{𐑮}}     % roar  — complex-axis criticality
\newcommand{\PhiEP}{\shav{𐑻}}     % err   — exceptional-point criticality
\newcommand{\Phisuper}{\shav{𐑣}}  % haha  — supercritical, unstable

% ⊥ — Chirality.  Core.lean ctor order: fee, kick, sure, wool.
\newcommand{\Hchir}{\axis{⊥}}
\newcommand{\Hzero}{\shav{𐑓}}   % fee  — achiral, no handedness to break
\newcommand{\Hone}{\shav{𐑒}}    % kick — soft chiral, period-2 under shift
\newcommand{\Htwo}{\shav{𐑖}}    % sure — persistent chiral, descent through rank
\newcommand{\Hinf}{\shav{𐑫}}    % wool — topological, inexhaustible chirality

% ⊞ — Stoichiometry.  Core.lean ctor order: hung, so, up.
\newcommand{\Sstoi}{\axis{⊞}}
\newcommand{\Sone}{\shav{𐑙}}   % hung — 1:1
\newcommand{\Snn}{\shav{𐑕}}    % so   — n:n, matched many-to-many
\newcommand{\Snm}{\shav{𐑳}}    % up   — n:m, unmatched many-to-many

% Ω — Topological Invariant
\newcommand{\Omzero}{\prim{Ω}{Å}}
\newcommand{\Omtwo}{\prim{Ω}{2}}
\newcommand{\Omz}{\prim{Ω}{z}}
\newcommand{\Omna}{\prim{Ω}{5}}

% ── odot_operator tuple ───────────────────────────────────────────────────────
% \odottuple — the ⊙perator's structural type, precomposed
\newcommand{\odottuple}{%
  \synthtype{\Dodot; \Tbox; \Rlr; \Pfrob; \Fhbar; \Kslow; \Galeph; \IGseq; \Phic; \Htwo; \Sone; \Omz}%
}
